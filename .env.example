# Copy this file to .env and fill in your own keys. Never commit .env to git.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pinecone vector database — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=crime-report-ai

# Optional: Gemini model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional: embedding provider — "sentence-transformers" (default, local/free) or "gemini"
EMBEDDING_PROVIDER=sentence-transformers
