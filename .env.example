# Copy this file to .env and fill in your own keys. Never commit .env to git.

# Which LLM powers classification, questions, summaries, and image/video
# analysis: "gemini" (default), "grok" (xAI), or "groq" (Groq fast-inference
# open-model hosting — a different company from Grok/xAI). Only the keys for
# your chosen provider need to be set.
LLM_PROVIDER=gemini

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- xAI Grok (used when LLM_PROVIDER=grok) ---
# https://console.x.ai
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TEXT_MODEL=grok-4.6
GROK_VISION_MODEL=grok-4.6

# --- Groq (used when LLM_PROVIDER=groq) ---
# https://console.groq.com — key prefix is "gsk_"
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Pinecone vector database (RAG) ---
# https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=crime-report-ai

# --- Embeddings — "sentence-transformers" (default, local/free) or "gemini" ---
EMBEDDING_PROVIDER=sentence-transformers

# --- Local speech-to-text for voice input (independent of LLM_PROVIDER) ---
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base

# --- Field-level encryption for sensitive PII (CNIC) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
